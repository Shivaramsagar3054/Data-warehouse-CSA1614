10. Implement using R language in which age group of people are affected byblood pressure based on the diabetes dataset show it using scatterplot and bar chart (that is BloodPressure vs Age using dataset “diabetes.csv”)
# Load diabetes dataset
diabetes <- read.csv("C:/Users/thero/Downloads/archive/diabetes.csv")
# View data
head(diabetes)
# Scatterplot: Blood Pressure vs Age
plot(diabetes$Age,
     diabetes$BloodPressure,
     main = "Blood Pressure vs Age",
     xlab = "Age",
     ylab = "Blood Pressure",
     pch = 19)
# Create age groups
diabetes$AgeGroup <- cut(
  diabetes$Age,
  breaks = c(20, 30, 40, 50, 60, 70, 80),
  labels = c("20-29", "30-39", "40-49",
             "50-59", "60-69", "70-79"),
  right = FALSE
)
# Calculate average Blood Pressure for each age group
avg_bp <- aggregate(BloodPressure ~ AgeGroup,
                    data = diabetes,
                    FUN = mean)
print(avg_bp)
# Bar chart
barplot(avg_bp$BloodPressure,
        names.arg = avg_bp$AgeGroup,
        main = "Average Blood Pressure by Age Group",
        xlab = "Age Group",
        ylab = "Average Blood Pressure")

 

